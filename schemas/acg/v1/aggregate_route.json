{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "acg/v1"
    },
    "kind": {
      "const": "AggregateRoute"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_identity": {
          "type": "string",
          "pattern": "^[^/\\s]+/AggregateRoute/[^\\x00-\\x1f\\x7f]+$"
        },
        "migration_job": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_identity",
        "migration_job"
      ]
    },
    "aggregate_route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider_ref": {
                "type": "string",
                "pattern": "^[^/\\s]+/Provider/[^\\x00-\\x1f\\x7f]+$"
              },
              "priority": {
                "type": "integer"
              },
              "weight": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "provider_ref",
              "priority",
              "weight"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "members"
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "aggregate_route"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acg/v1 AggregateRoute",
  "$comment": "Structural contract. Go validation additionally enforces reference instance isolation, CIDRs, and consistent duplicate route members."
}
