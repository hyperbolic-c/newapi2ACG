{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "acg/v1"
    },
    "kind": {
      "const": "ApiKey"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_identity": {
          "type": "string",
          "pattern": "^[^/\\s]+/ApiKey/[^\\x00-\\x1f\\x7f]+$"
        },
        "migration_job": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_identity",
        "migration_job"
      ]
    },
    "apikey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "user_ref": {
          "type": "string",
          "pattern": "^[^/\\s]+/User/[^\\x00-\\x1f\\x7f]+$"
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "fingerprint"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ip_allowlist": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "provider_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/Provider/[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "route_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+/(AggregateRoute|Provider)/[^\\x00-\\x1f\\x7f]+$"
          }
        }
      },
      "required": [
        "name",
        "user_ref",
        "key",
        "enabled",
        "expires_at",
        "ip_allowlist",
        "provider_refs",
        "route_refs"
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "apikey"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acg/v1 ApiKey",
  "$comment": "Structural contract. Go validation additionally enforces reference instance isolation, CIDRs, and consistent duplicate route members."
}
