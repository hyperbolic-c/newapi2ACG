{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "acg/v1"
    },
    "kind": {
      "const": "User"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_identity": {
          "type": "string",
          "pattern": "^[^/\\s]+/User/[^\\x00-\\x1f\\x7f]+$"
        },
        "migration_job": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_identity",
        "migration_job"
      ]
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "display_name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "enabled": {
          "type": "boolean"
        },
        "group_ref": {
          "type": "string",
          "pattern": "^[^/\\s]+/Group/[^\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "username",
        "role",
        "enabled",
        "group_ref"
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "user"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acg/v1 User",
  "$comment": "Structural contract. Go validation additionally enforces reference instance isolation, CIDRs, and consistent duplicate route members."
}
