{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "mapping": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "dry_run": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "mapping",
        "target"
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "enum": [
            "fail",
            "skip",
            "update"
          ]
        },
        "unsupported": {
          "enum": [
            "fail"
          ]
        },
        "missing_reference": {
          "enum": [
            "fail"
          ]
        },
        "missing_secret": {
          "enum": [
            "fail"
          ]
        },
        "drift": {
          "enum": [
            "report",
            "overwrite"
          ]
        },
        "on_source_delete": {
          "enum": [
            "disable",
            "report"
          ]
        },
        "prune": {
          "enum": [
            "report",
            "delete"
          ]
        },
        "auto_disabled_channel": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "exhausted_token": {
          "enum": [
            "disabled",
            "enabled"
          ]
        },
        "direct_routes": {
          "enum": [
            "none",
            "group_channels"
          ]
        },
        "cross_instance_conflict": {
          "enum": [
            "fail"
          ]
        }
      },
      "required": []
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "retry_backoff": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "write_rate_limit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*/s$"
        },
        "request_timeout": {
          "type": "string",
          "minLength": 1
        },
        "max_pending": {
          "type": "integer",
          "minimum": 1
        },
        "fanout_alert": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    }
  },
  "required": [
    "job"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migrator job",
  "$comment": "Go semantic validation additionally checks durations, source field coverage and filename identity. Independent schema validation is a separate gate."
}
