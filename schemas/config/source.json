{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "require_columns": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "required": [
                "require_columns"
              ]
            }
          },
          "required": [
            "database"
          ]
        }
      },
      "required": [
        "supported",
        "probe"
      ]
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "primary_key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "schema": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "int",
                    "bool",
                    "string",
                    "json",
                    "timestamp",
                    "secret"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "default": {}
              },
              "required": [
                "type"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "secret"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "default"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "int"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "default": {
                        "type": "integer"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "bool"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "default": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "string"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "default": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "timestamp"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "default": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              ]
            }
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "bindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "database": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "table": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                  }
                },
                "required": [
                  "table"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "primary_key",
          "schema",
          "bindings"
        ]
      }
    }
  },
  "required": [
    "version",
    "project",
    "compat",
    "datasets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migrator source",
  "$comment": "Go semantic validation additionally checks durations, source field coverage and filename identity. Independent schema validation is a separate gate."
}
