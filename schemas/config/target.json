{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "type": {
      "enum": [
        "memory",
        "file",
        "acg"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "credential_env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "state_dsn_env": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "supported",
          "unsupported",
          "unknown"
        ]
      }
    }
  },
  "required": [
    "target",
    "type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "acg"
          }
        }
      },
      "then": {
        "required": [
          "base_url",
          "credential_env"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "base_url"
              ]
            },
            {
              "required": [
                "credential_env"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file"
          }
        }
      },
      "then": {
        "required": [
          "output_dir"
        ]
      },
      "else": {
        "not": {
          "required": [
            "output_dir"
          ]
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migrator target",
  "$comment": "Go semantic validation additionally checks durations, source field coverage and filename identity. Independent schema validation is a separate gate."
}
